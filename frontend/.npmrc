# Read by every npm command (docs/PLAN.md, S3c, finding C3).
# No package runs its install script; a package that needs one is named in
# the plan first.
ignore-scripts=true
# Versions are written exactly as resolved.
save-exact=true
# Nothing published in the last seven days is installed: most hijacked
# releases are found and pulled within that time.
min-release-age=7
fund=false
update-notifier=false
