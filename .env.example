# Copy to .env on the server and fill in (docs/DEPLOY.md). None of these is a
# secret; the proxy key is a file in secrets/.

# The server's own LAN address: the port is published on it and nothing else.
XBLOOM_PUBLISH_IP=192.0.2.10
# The phone running the ESPHome Bluetooth proxy.
XBLOOM_PROXY_HOST=192.0.2.20
# Host names the hub answers to. Keep 127.0.0.1: the healthcheck uses it.
XBLOOM_ALLOWED_HOSTS=localhost,127.0.0.1,192.0.2.10
# Client networks the hub answers. Keep 127.0.0.0/8 for the healthcheck.
XBLOOM_ALLOWED_NETWORKS=127.0.0.0/8,::1/128,192.0.2.0/24
